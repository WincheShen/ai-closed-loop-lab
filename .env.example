# =============================================================================
# AI Closed Loop Lab — Environment Configuration
# =============================================================================

# --- LLM Providers (at least one required) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
XAI_API_KEY=...

# Azure OpenAI (optional enterprise)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# --- A-Share Market Data ---
EASTMONEY_TOKEN=          # Optional: for enhanced akshare quotas
TUSHARE_TOKEN=            # Optional: tushare pro token

# --- Trading (Paper Trading / Simulation) ---
# 交易模式: mock(仅模拟) / shadow(双轨:mock+实盘) / live(纯实盘)
TRADING_MODE=mock

# --- miniQMT Bridge (实盘接入) ---
# Bridge Server 运行在装有 miniQMT 的 Windows 机器上
# 参见 scripts/miniQMT_bridge.py
XTQUANT_BRIDGE_URL=http://192.168.3.100:9090
XTQUANT_BRIDGE_TOKEN=your-secret-token
XTQUANT_ACCOUNT_ID=8888888888

# 安全护栏 (仅 shadow/live 模式生效)
MAX_SINGLE_ORDER_AMOUNT=10000       # 单笔最大金额(元)
MAX_DAILY_BUY_AMOUNT=30000          # 日最大买入金额(元)
MAX_TOTAL_POSITION_VALUE=50000      # 持仓总市值上限(元)
MAX_DAILY_ORDERS=10                 # 日最大下单次数
MAX_DAILY_LOSS=1000                 # 日亏损熔断线(元)

# 旧配置 (保留兼容)
BROKER_API_URL=
BROKER_API_KEY=
BROKER_SECRET=
BROKER_ACCOUNT=

# --- Social Media ---
# 小红书账号 cookies / session (由 vendor/xiaohongshu-skills 管理)
XHS_SKILLS_DIR=vendor/social_media_automation/vendor/xiaohongshu-skills

# --- Central Brain Persistence ---
DB_PATH=data/central_brain.db
VECTOR_DB_PATH=data/vector_memory.db

# --- PostgreSQL (Strategy Mining + future shared store) ---
PG_HOST=192.168.3.73
PG_PORT=5433
PG_DB=agent_data
PG_USER=admin
PG_PASSWORD=
PG_DSN=postgresql://admin:CHANGE_ME@192.168.3.73:5433/agent_data

# --- WeChat Official Account Crawler (strategy_mining) ---
# (a) 公众号后台登录态（用于列出某公众号历史文章 URL）
#     来源：https://mp.weixin.qq.com/ 后台 F12
WX_MP_TOKEN=
WX_MP_COOKIE=

# (c) 公众号发布（Influencer Agent 推送文章）
#     来源：微信公众平台 → 设置 → 开发 → 基本配置
WX_MP_APPID=
WX_MP_APPSECRET=

# (b) 微信客户端登录态（用于拉文章阅读量/点赞/评论/评论图片）
#     来源：PC 微信 + mitmproxy/Charles 抓 /mp/getappmsgext 请求
#     详见 docs/strategy_mining.md 抓包指引
WX_APPMSG_TOKEN=
WX_CLIENT_COOKIE=

# --- System ---
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
DATA_DIR=data
RESULTS_DIR=reports
