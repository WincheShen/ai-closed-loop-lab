#!/usr/bin/env bash

# AI Closed Loop Lab — 开发者辅助脚本
#
# Usage:
#   ./scripts/dev up           启动所有服务 (后端 + 前端)
#   ./scripts/dev down         停止所有服务
#   ./scripts/dev scan         执行一次每日选股扫描
#   ./scripts/dev workflow     执行完整 Agent 工作流
#   ./scripts/dev report       查看最新 Agent 日报
#   ./scripts/dev test         运行测试

set -e

CMD=$1

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_ROOT"

export PYTHONPATH="$PROJECT_ROOT/src"

start() {
    ./scripts/start_all.sh
}

stop() {
    echo "Stopping services..."
    pkill -f run_trading_agent_service.py 2>/dev/null || true
    pkill -f run_webhook_listener.py 2>/dev/null || true
    pkill -f "npm run dev" 2>/dev/null || true
    pkill -f "vite" 2>/dev/null || true
    echo "Done."
}

scan() {
    echo "Running daily scan..."
    python scripts/run_daily_scan.py "$@"
}

workflow() {
    echo "Running full daily workflow..."
    python scripts/run_daily_workflow.py "$@"
}

report() {
    echo "Latest agent report:"
    curl -s http://localhost:8002/api/agent-report/dates | python -m json.tool
}

tests() {
    echo "Running test suite..."
    pytest -v
}

case "$CMD" in
    up|start)
        start
        ;;
    down|stop)
        stop
        ;;
    scan)
        shift
        scan "$@"
        ;;
    workflow)
        shift
        workflow "$@"
        ;;
    report)
        report
        ;;
    test)
        tests
        ;;
    *)
        echo "AI Closed Loop Lab — 开发者辅助"
        echo ""
        echo "Usage: ./scripts/dev <command>"
        echo ""
        echo "Commands:"
        echo "  up        启动所有服务 (后端 + 前端)"
        echo "  down      停止所有服务"
        echo "  scan      执行一次每日选股扫描"
        echo "  workflow   执行完整 Agent 工作流"
        echo "  report    查看最新 Agent 日报日期列表"
        echo "  test      运行测试"
        exit 1
        ;;
esac
